import os
import time
from pyngrok import ngrok

ngrok.set_auth_token("REDACTED") 

ngrok.kill()
os.system("pkill -f ngrok 2>/dev/null")
time.sleep(3)

os.system("pkill -f streamlit 2>/dev/null")
time.sleep(2)

os.system("streamlit run app.py --server.port 8501 >/tmp/streamlit.log 2>&1 &")
time.sleep(8)

public_url = ngrok.connect(8501)

print("🔗 App URL:", public_url)
